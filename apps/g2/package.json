{
  "name": "@greenlight/g2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ehpk": "vite build && node -e \"require('fs').mkdirSync('out',{recursive:true})\" && evenhub pack app.json dist -o out/greenlight.ehpk"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0",
    "@evenrealities/evenhub-cli": "^0.2.0"
  }
}
