# Copy to .env and fill in real values. Every value below is fake.
# Real keys go only in .env / .env.local (both git-ignored), never in git, chat or the G2 bundle.

# --- Server ---
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
SQLITE_PATH=./data/greenlight.sqlite
SESSION_SECRET=fake-long-random-string

# --- AI Policy Guard (Anthropic direct OR OpenRouter; set one) ---
ANTHROPIC_API_KEY=sk-ant-fake
# Check the current model ID before the demo; do not hard-code it in source.
POLICY_MODEL=claude-haiku-5-5
# OPENROUTER_API_KEY=sk-or-fake

# --- Telegram bot (create with @BotFather; disable privacy mode for group use) ---
TELEGRAM_BOT_TOKEN=123456:fake
TELEGRAM_WEBHOOK_SECRET=fake-webhook-secret

# --- Google OAuth (Cloud Console, OAuth consent screen in Testing mode, add test users) ---
GOOGLE_CLIENT_ID=fake.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=fake
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- ElevenLabs (demo voice-over only, used by video/ tooling, never by the app) ---
# `npx -y @elevenlabs/cli@latest onboard init` writes this to .env.local.
ELEVENLABS_API_KEY=fake
